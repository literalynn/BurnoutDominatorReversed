// The icon and the description Windows shows for BurnoutDominator.exe.
1 ICON "BurnoutDominator.ico"

1 VERSIONINFO
FILEVERSION 1, 1, 0, 0
PRODUCTVERSION 1, 1, 0, 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Burnout Dominator Reversed launcher"
            VALUE "ProductName", "Burnout Dominator Reversed"
            VALUE "OriginalFilename", "BurnoutDominator.exe"
            VALUE "LegalCopyright", "GPL-3.0. Not affiliated with Electronic Arts, Criterion Games or Sony."
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
